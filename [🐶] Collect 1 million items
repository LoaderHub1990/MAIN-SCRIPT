local function applyCharacter(character)
    local humanoid = character:WaitForChild("Humanoid", 10)
    local root = character:WaitForChild("HumanoidRootPart", 10)
    if humanoid and root then
        task.spawn(function()
            while character.Parent and LocalPlayer.Character == character do
                local dt = RunService.Heartbeat:Wait()
                if State.SpeedEnabled and humanoid.Health > 0 then
                    local direction = humanoid.MoveDirection
                    if direction.Magnitude > 0 then
                        root.AssemblyLinearVelocity = Vector3.new(direction.X * State.SpeedValue, root.AssemblyLinearVelocity.Y, direction.Z * State.SpeedValue)
                    end
                end
                if State.FlyEnabled and root.Parent then
                    local camera = workspace.CurrentCamera
                    if camera then
                        local velocity = Vector3.zero
                        local look = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z)
                        local right = Vector3.new(camera.CFrame.RightVector.X, 0, camera.CFrame.RightVector.Z)
                        if look.Magnitude > 0 then look = look.Unit end
                        if right.Magnitude > 0 then right = right.Unit end
                        if UserInputService:IsKeyDown(Enum.KeyCode.W) then velocity += look * State.FlySpeed end
                        if UserInputService:IsKeyDown(Enum.KeyCode.S) then velocity -= look * State.FlySpeed end
                        if UserInputService:IsKeyDown(Enum.KeyCode.A) then velocity -= right * State.FlySpeed end
                        if UserInputService:IsKeyDown(Enum.KeyCode.D) then velocity += right * State.FlySpeed end
                        if UserInputService:IsKeyDown(State.FlyUpKey) then velocity += Vector3.new(0, State.FlyVerticalSpeed, 0) end
                        if UserInputService:IsKeyDown(State.FlyDownKey) then velocity -= Vector3.new(0, State.FlyVerticalSpeed, 0) end
                        root.AssemblyLinearVelocity = velocity
                    end
                end
                if State.Noclip then
                    for _, part in ipairs(character:GetDescendants()) do
                        if part:IsA("BasePart") then part.CanCollide = false end
                    end
                end
            end
        end)
    end
end

if LocalPlayer.Character then task.spawn(applyCharacter, LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(applyCharacter)

UserInputService.JumpRequest:Connect(function()
    if not State.InfiniteJump then return end
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if humanoid then humanoid:ChangeState(Enum.HumanoidStateType.Jumping) end
end)

