local function fire(remote, ...)
    if remote and remote:IsA("RemoteEvent") then
        local args = table.pack(...)
        pcall(function()
            remote:FireServer(table.unpack(args, 1, args.n))
        end)
    end
end

local function equipPusher()
    local character = LocalPlayer.Character
    if not character then return false end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end
    local tool = character:FindFirstChildWhichIsA("Tool")
    if tool and (tool.Name:find("Pusher") or table.find(Pushers, tool.Name)) then return true end
    local current = LocalPlayer:FindFirstChild("PusherCurrent")
    local wanted = current and current.Value or "Pusher"
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if not backpack then return false end
    local found = backpack:FindFirstChild(wanted) or backpack:FindFirstChild("Pusher")
    if not found then
        for _, name in ipairs(Pushers) do
            found = backpack:FindFirstChild(name)
            if found then break end
        end
    end
    if found then
        pcall(function() humanoid:EquipTool(found) end)
        return true
    end
    fire(Remote.EquipPusher, wanted)
    return false
end

local soldTokens = {}
local function sellItem(item)
    if not State.AutoSell or not item or not item.Parent or item.Name == "Rat" then return end
    local token = item:GetAttribute("SellToken")
    if not token or soldTokens[token] then return end
    soldTokens[token] = true
    local readyAt = item:GetAttribute("SellReadyAt")
    local delayTime = readyAt and math.max(0, readyAt - time()) or 0
    if delayTime > 0 then task.wait(delayTime) end
    if not State.AutoSell or not item.Parent or item:GetAttribute("SellInProgress") then return end
    item:SetAttribute("SellInProgress", true)
    local itemName = item:GetAttribute("VIPGem") and "Gem" or item.Name
    fire(Remote.SellItem, itemName, token)
    pcall(function() item:Destroy() end)
end

local sellConnection
local function setAutoSell(enabled)
    State.AutoSell = enabled
    soldTokens = {}
    if sellConnection then sellConnection:Disconnect() sellConnection = nil end
    if enabled then
        for _, item in ipairs(LocalItems:GetChildren()) do
            task.spawn(sellItem, item)
        end
        sellConnection = LocalItems.ChildAdded:Connect(function(item)
            task.spawn(sellItem, item)
        end)
    end
end

local function getCurrentValue(player, names, fallback)
    for _, name in ipairs(names) do
        local value = player:FindFirstChild(name) or HiddenStats:FindFirstChild(name)
        if value and value:IsA("ValueBase") then return value.Value end
    end
    return fallback
end

local function runAutomation()
    while task.wait(0.2) do
        if State.AutoRebirth and RebirthPricing then
            pcall(function()
                local price = RebirthPricing.GetPrice(Rebirth.Value)
                local ready = PrestigeConfig and PrestigeConfig.IsPrestigeReady and PrestigeConfig.IsPrestigeReady(Prestige.Value, Rebirth.Value)
                if price and price <= Cash.Value and not ready then
                    fire(Remote.BuyRebirth, HttpService:GenerateGUID(false), Rebirth.Value, Prestige.Value)
                end
            end)
        end
        if State.AutoPrestige and PrestigeConfig then
            pcall(function()
                if PrestigeConfig.IsPrestigeReady and PrestigeConfig.IsPrestigeReady(Prestige.Value, Rebirth.Value) then
                    fire(Remote.BuyPrestige, HttpService:GenerateGUID(false), Rebirth.Value, Prestige.Value)
                end
            end)
        end
        if State.AutoClaimIndex then
            pcall(function()
                local allCollected = true
                for _, item in ipairs(Index:GetChildren()) do
                    if item:IsA("BoolValue") and not item.Value then
                        allCollected = false
                        break
                    end
                end
                if allCollected then fire(Remote.ClaimIndexReward, "ALL") end
            end)
        end
        if State.AutoGemDealer then
            pcall(function()
                if TotalItems.Value >= 250 then fire(Remote.SellItemsForGems) end
            end)
        end
        if State.AutoPusher and PusherShop then
            pcall(function()
                local current = LocalPlayer:FindFirstChild("PusherCurrent")
                for _, name in ipairs(Pushers) do
                    local requirement = PusherShop.GetRequirement and PusherShop.GetRequirement(name)
                    local owned = PusherOwned:FindFirstChild(name)
                    local has = owned and owned.Value == true
                    local canUnlock = PusherShop.CanUnlockHere and PusherShop.CanUnlockHere(name)
                    if has or (requirement and requirement <= Collected.Value and canUnlock) then
                        if not current or current.Value ~= name then fire(Remote.EquipPusher, name) end
                        break
                    end
                end
            end)
        end
        if State.AutoTrail and TrailShop then
            pcall(function()
                for _, name in ipairs(Trails) do
                    if TrailOwned:FindFirstChild(name) then break end
                    local price = TrailShop.GetPrice and TrailShop.GetPrice(name)
                    if price and price <= Cash.Value then
                        fire(Remote.BuyEquipTrail, name)
                        break
                    end
                end
            end)
        end
        if State.AutoAura and AuraShop then
            pcall(function()
                for _, name in ipairs(Auras) do
                    if AuraOwned:FindFirstChild(name) then break end
                    local previous = AuraShop.GetPreviousAura and AuraShop.GetPreviousAura(name)
                    if (not previous or AuraOwned:FindFirstChild(previous)) then
                        local price = AuraShop.GetPrice and AuraShop.GetPrice(name)
                        if price and price <= Gems.Value then
                            fire(Remote.BuyEquipAura, name)
                            break
                        end
                    end
                end
            end)
        end
        for name, enabled in pairs(State.CashUpgrades) do
            if enabled then
                pcall(function() fire(Remote.BuyUpgrade, name, State.UpgradeMode == "max") end)
            end
        end
        if State.AutoAbilities and os.clock() - (State.LastAbility or 0) >= 1.5 then
            if equipPusher() then
                pcall(function()
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                    task.wait(0.05)
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                end)
                State.LastAbility = os.clock()
            end
        end
        if State.FreezeStreak then fire(Remote.SetStreakUIFrozen, true) end
    end
end
task.spawn(runAutomation)

