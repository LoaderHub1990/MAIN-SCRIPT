    elseif name == "Settings" then
        activeTab = SettingsTab
    end
end
local function ShowTab(name)
    CreateTab(name)
end
local function CreateBlock(title)
    activeGroup = activeTab:Group(title)
end
local function EndBlock()
    activeGroup = nil
end
local function CreateToggle(title, callback)
    if activeGroup then
        return activeGroup:Toggle({Title = title, Callback = callback})
    end
end
local function CreateActiveKeybind(config)
    if activeGroup then
        return activeGroup:Toggle({Title = config.Text or "Enable", Callback = config.Callback})
    end
end
local function CreateSlider(config)
    if activeGroup then
        return activeGroup:Slider({
            Title = config.Text,
            Min = config.Min,
            Max = config.Max,
            Default = config.Default,
            Step = config.Step or 1,
            Callback = config.Callback
        })
    end
end
local function CreateDropdown(config)
    if not activeGroup then return nil end
    local control = activeGroup:Dropdown({
        Title = config.Text,
        Options = config.List or {},
        Default = config.Default,
        Callback = config.Callback
    })
    -- Preserve the original Clear/Add calls when changing worlds; use native methods if available.
    local adapter = {}
    function adapter:Clear()
        if control and type(control.Clear) == "function" then
            pcall(function() control:Clear() end)
        elseif control and type(control.SetOptions) == "function" then
            pcall(function() control:SetOptions({}) end)
        end
    end
    function adapter:Add(options)
        if control and type(control.Add) == "function" then
            pcall(function() control:Add(options) end)
        elseif control and type(control.SetOptions) == "function" then
            pcall(function() control:SetOptions(options) end)
        end
    end
    return adapter
end
local function CreateNotification(title, message, duration, status)
    if type(Window.Notify) == "function" then
        pcall(function()
            Window:Notify({
                Title = tostring(title or "Flexozy"),
                Content = tostring(message or "") .. " " .. tostring(status or ""),
                Type = status == "Disabled" and "Warning" or "Success",
                Duration = duration or 2
            })
        end)
    end
end

